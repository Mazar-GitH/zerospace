          ],
          "lines": [
            {
              "text": "Damage 50 to 25"
            },
            {
              "text": "Area damage 100% to 50%"
            },
            {
              "text": "Projectile homing speed +60%"
            },
            {
              "text": "Projectile duration 5s to 6s"
            },
            {
              "text": "Time Bend now shows a visual at the cast spot until the units return"
            }
          ]
        },
        {
          "subject": "Eradicator",
          "entityIds": [
            "the-xol/unit/eradicator"
          ],
          "lines": [
