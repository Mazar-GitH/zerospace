        },
        {
          "subject": "Anrubic",
          "entityIds": [
            "the-xol/hero/anrubic"
          ],
          "lines": [
            {
              "text": "Blink now moves only Anrubic instead of nearby units too"
            },
            {
              "text": "Launch Rollers damage 30 to 15, radius 2 to 1.5"
            }
          ]
        }
      ]
    },
