          "lines": [
            {
              "text": "Improved Charge now gives 3 armor for 3 seconds after charging instead of an extra charge"
            },
            {
              "text": "Wake of Fire no longer gives 3 armor for 5 seconds after charging"
            }
          ]
        }
      ]
