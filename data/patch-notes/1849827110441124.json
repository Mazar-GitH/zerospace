  "sections": [
    {
      "faction": "grell",
      "heading": "Grell",
      "entries": [
        {
          "subject": "Lasher",
          "entityIds": [
            "grell/unit/lasher"
          ],
          "lines": [
            {
              "text": "Damage 11 to 12"
            },
            {
              "text": "Attack cooldown 1.2s to 1.4s"
            },
            {
              "text": "Attacks now apply a stacking 1 damage per second for 5 seconds"
            },
            {
              "text": "Move speed 600 to 625"
            },
            {
              "text": "The +damage to medium upgrade is replaced with Take Flight: Lashers fly for 3 seconds with +250 move speed and cannot attack while flying"
            }
          ]
        },
        {
          "subject": "Weaver",
          "entityIds": [
            "grell/unit/weaver"
          ],
          "lines": [
            {
              "text": "Cost 100/200 to 100/150"
            },
            {
              "text": "Acid Blight no longer has a cast or channel time"
            }
          ]
        },
        {
          "subject": "Harvester and Cultivator",
          "entityIds": [
            "grell/unit/gatherer",
            "grell/building/cultivator"
          ],
          "lines": [
            {
              "text": "Cultivator cost 15 to 10"
            },
            {
              "text": "Cultivator health 150 to 100"
            },
            {
              "text": "Spawn Cultivator cooldown 75s to 60s, and its cool up time is removed"
            },
            {
              "text": "Cultivators can only be spawned on biomass"
            },
            {
              "text": "Biomass regeneration 1 to 2 health per second"
            },
            {
              "text": "Mycelial Reach now makes Harvesters generate biomass"
            },
            {
              "text": "Mycelial Reach cooldown reduction 45s to 30s"
            }
          ]
        },
        {
          "subject": "Thresher",
          "entityIds": [
            "grell/unit/thresher"
          ],
          "lines": [
            {
              "text": "Cost 100/200 to 100/175"
            }
          ]
        },
        {
          "subject": "Nourishing Pod",
          "entityIds": [
            "grell/building/nourishing-pod"
          ],
          "lines": [
            {
              "text": "Heal per energy 4 to 3"
            },
            {
              "text": "Max energy used per heal 4 to 10"
            }
          ]
        },
        {
          "subject": "Harbinger",
          "entityIds": [
            "grell/unit/harbinger"
          ],
          "lines": [
            {
              "text": "Thermal Carapace, Cardiovascular Boost and Coagulated Membrane removed"
            },
            {
              "text": "Hemal Vents moved to Tier 1, cost 125 to 100 flux, research time 60s to 40s"
            },
            {
              "text": "New Tier 1 upgrade Myogenic Tarsals: +175 move speed and +1 armor"
            },
            {
              "text": "The Eruption talent no longer requires the Elderwomb"
            }
          ]
        }
      ]
    },
    {
